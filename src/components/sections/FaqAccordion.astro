---
import { FaqList } from './FaqList.tsx';

interface Props {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { faqs } = Astro.props;
---

<section class="py-16 md:py-24 bg-background" id="faq">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="text-center mb-12">
      <h2
        class="font-serif text-[clamp(2rem,4vw+1rem,3rem)] font-bold mb-4 leading-tight text-primary"
      >
        Frequently Asked Questions
      </h2>
      <p class="text-muted-foreground text-base md:text-lg max-w-xl mx-auto">
        Common questions about the workshop
      </p>
    </div>

    <div class="bg-card rounded-lg border p-6 md:p-8 shadow-sm">
      <FaqList client:visible items={faqs} />
    </div>
  </div>
</section>
