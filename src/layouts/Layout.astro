---
import ThemeInit from '@/components/ThemeInit.astro';
import GoogleTagManager from '@/components/analytics/GoogleTagManager.astro';
import { StickyFooter } from '@/components/cta-sticky-footer';
import { siteConfig } from '@/config/site';
import '../styles/global.css';

interface Props {
  title: string;
  desc?: string;
  image?: string;
  type?: string;
  lang?: 'en' | 'id';
  children: any;
}

const {
  title,
  desc = 'A beautiful dashboard built with Astro and shadcn/ui',
  image = '/og.jpg',
  type = 'website',
  lang = 'en',
} = Astro.props;

// Generate canonical URL and full image URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={desc} />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={desc} />
    <meta property="twitter:image" content={imageURL} />

    <ThemeInit />
    {siteConfig.gtmId && <GoogleTagManager id={siteConfig.gtmId} />}
  </head>

  <body class="min-h-screen bg-background font-sans antialiased">
    <ThemeInit />
    <StickyFooter client:load lang={lang} />
    <main class="book-column min-h-screen py-12 md:py-24">
      <slot />
    </main>

    <!-- Simple Footer for Campaign -->
    <footer class="text-center py-8 text-sm text-muted-foreground">
      <p>
        &copy; {new Date().getFullYear()} Parenting Workshop. All rights reserved.
      </p>
    </footer>
    <!-- Scroll Reveal Observer -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // one-shot reveal
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        document
          .querySelectorAll('.animate-on-scroll')
          .forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
